{
  "name": "plantilla-web",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@node-minify/core>glob": "10.5.0",
      "miniflare>undici": "7.30.1"
    }
  },
  "scripts": {
    "predev": "npm run cf-typegen",
    "dev": "next dev",
    "prebuild": "npm run cf-typegen",
    "build": "next build",
    "lint": "eslint src tests tailwind.config.ts --max-warnings=0",
    "lint:fix": "eslint src tests tailwind.config.ts --fix --max-warnings=0",
    "pretest:frontend": "npm run cf-typegen",
    "test:frontend": "tsc -p tsconfig.tests.json && node --test .test-build/tests/frontend.test.js .test-build/tests/boveda.test.js",
    "pretest:formularios": "npm run cf-typegen",
    "test:formularios": "tsc -p tsconfig.tests.json && node --conditions=react-server --test .test-build/tests/formularios.test.js",
    "pretest:proteccion": "npm run cf-typegen",
    "test:proteccion": "tsc -p tsconfig.tests.json && node --test .test-build/tests/proteccion.test.js",
    "pretest:runtime": "npm run cf-typegen",
    "test:runtime": "tsc -p tsconfig.tests.json && node --test .test-build/tests/runtime.test.js",
    "check": "npm run lint && npm run test:formularios && npm run test:frontend && npm run test:proteccion && opennextjs-cloudflare build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:staging": "opennextjs-cloudflare build --env staging && opennextjs-cloudflare deploy --env staging",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.21.0",
    "drizzle-kit": "^0.31.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "postcss": "^8",
    "postcss-import": "^16.1.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.156.0"
  }
}
